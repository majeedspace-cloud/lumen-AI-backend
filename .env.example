GEMINI_API_KEY=your-key-here
HF_TOKEN=your-token-here
TAVILY_API_KEY=your-key-here

SESSION_BACKEND=memory
SESSION_TTL_SECONDS=21600
SESSION_CLEANUP_INTERVAL_SECONDS=1800

# Security — set these before deploying anywhere public
ALLOWED_ORIGINS=http://localhost:5173
API_KEY=generate-a-long-random-string-here
MAX_UPLOAD_MB=15
MAX_QUERY_LENGTH=2000
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
DEBUG_MODE=false

# Deployment optimization
# Set to true only for testing in memory-constrained environments
# When true, ML models won't load and most features will be disabled
SKIP_MODEL_LOADING=false
